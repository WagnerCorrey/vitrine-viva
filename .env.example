HOST=127.0.0.1
PORT=3000
# Senha somente para demonstração local. Troque antes de expor em uma rede.
ADMIN_PASSWORD=jupara-demo
DATA_DIR=./data
# Configure uma chave e um modelo disponível na sua conta para extração real.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Ambos são necessários. O chat autorizado deve ser privado.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Endereço da aplicação usado nas mensagens, sem barra final.
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
